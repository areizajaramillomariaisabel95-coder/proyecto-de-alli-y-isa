on.\n"}]}],"snapshots":[{"timestamp":1794704581199,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"proyecto de Alli y Isa\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}},{"timestamp":1794707297198,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block><block type=\"device_forever\" x=\"225\" y=\"20\"></block></xml>","main.ts":"// ---------- Juego: esquivar la bomba ----------\n// Cinco niveles. Una sola vida.\n\nlet nivel = 1\nlet navePos = 2          // columna donde está la nave (0 a 4)\nlet pausaBase = 400      // cuánto tarda la bomba en bajar (nivel 1)\n\n// Mueve la nave: -1 izquierda, +1 derecha\nfunction moverNave(dir: number) {\n    let destino = navePos + dir\n        if (destino >= 0 && destino <= 4) {\n                navePos = destino\n                    }\n                    }\n\n                    input.onButtonPressed(Button.A, function () {\n                        moverNave(-1)\n                        })\n\n                        input.onButtonPressed(Button.B, function () {\n                            moverNave(1)\n                            })\n\n                            // Se muestra cuando la bomba te atrapa y se reinicia todo\n                            function finDelJuego() {\n                                basic.pause(400)\n                                    basic.clearScreen()\n                                        basic.showIcon(IconNames.Skull)\n                                            basic.pause(2000)\n                                                basic.clearScreen()\n                                                    control.reset()\n                                                    }\n\n                                                    // Pausa entre cada paso de la bomba, según el nivel\n                                                    function pausaDelNivel(): number {\n                                                        return pausaBase - (nivel - 1) * 50\n                                                        }\n\n                                                        // Una bomba baja desde arriba\n                                                        function bajarBomba(): boolean {\n                                                            let columnaBomba = randint(0, 4)\n                                                                let fila = 0\n                                                                    while (fila <= 4) {\n                                                                            basic.clearScreen()\n                                                                                    led.plot(navePos, 4)\n                                                                                            led.plot(columnaBomba, fila)\n\n                                                                                                    if (fila == 4 && columnaBomba == navePos) {\n                                                                                                                return true      // te atrapó\n                                                                                                                        }\n\n                                                                                                                                basic.pause(pausaDelNivel())\n                                                                                                                                        fila += 1\n                                                                                                                                            }\n                                                                                                                                                return false             // la esquivaste\n                                                                                                                                                }\n\n                                                                                                                                                // Muestra el nivel un momento antes de cada bomba\n                                                                                                                                                function avisarNivel() {\n                                                                                                                                                    basic.clearScreen()\n                                                                                                                                                        basic.showNumber(nivel)\n                                                                                                                                                            basic.pause(800)\n                                                                                                                                                            }\n\n                                                                                                                                                            basic.forever(function () {\n                                                                                                                                                                // solo mostramos el cartel al empezar el nivel 1\n                                                                                                                                                                    if (nivel == 1) {\n                                                                                                                                                                            avisarNivel()\n                                                                                                                                                                                }\n\n                                                                                                                                                                                    if (bajarBomba()) {\n                                                                                                                                                                                            finDelJuego()\n                                                                                                                                                                                                }\n\n                                                                                                                                                                                                    // la esquivó: sube de nivel, hasta el 5\n                                                                                                                                                                                                        if (nivel < 5) {\n                                                                                                                                                                                                                nivel += 1\n                                                                                                                                                                                                                    }\n                                                                                                                                                                                                                    })\n\t\n\n","README.md":"","pxt.json":"{\n    \"name\": \"proyecto de Alli y Isa\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares":[],"lastSaveTime":1794708462481}